<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls"
        xmlns:vm="clr-namespace:Cloris.Aion2Flow.ViewModels"
        x:Class="Cloris.Aion2Flow.Views.SkillMonitorWindow"
        x:DataType="vm:ComboAssistantViewModel"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SizeToContent="Height"
        Width="360"
        MinWidth="100"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="False">

    <Window.Styles>
        <StyleInclude Source="avares://Aion2Flow/Styles/OverlayTheme.axaml" />

        <Style Selector="controls|PerimeterProgressBar.MonitorBuffPerimeter">
            <Setter Property="Fill" Value="{StaticResource OverlayBrush.MainHudGold}" />
            <Setter Property="Thickness" Value="3" />
        </Style>

        <Style Selector="controls|SkillIcon.MonitorSkillIcon">
            <Setter Property="Stretch" Value="UniformToFill" />
        </Style>

        <Style Selector="TextBlock.MonitorCooldownText">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="ZIndex" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="2" OffsetX="0" OffsetY="0" Opacity="0.95" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="TextBlock.MonitorBuffText">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="ZIndex" Value="11" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="2" OffsetX="0" OffsetY="0" Opacity="0.95" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.MonitorChargeBadge">
            <Setter Property="Background" Value="#D9000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="ZIndex" Value="12" />
        </Style>

        <Style Selector="TextBlock.MonitorChargeText">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style Selector="Border.MonitorWindowRoot">
            <Setter Property="Background" Value="{StaticResource OverlayBrush.MainHudBackdrop}" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="Border.MonitorWindowRoot.unfocused">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Border.MonitorWidthResizeGrip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.MainHudGold}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Width" Value="7" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="ZIndex" Value="20" />
        </Style>

        <Style Selector="Border.MonitorWindowRoot.interactive Border.MonitorWidthResizeGrip">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="TextBlock.MonitorInteractionTitle">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.TextMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,2,10,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="Border.MonitorWindowRoot.interactive TextBlock.MonitorInteractionTitle">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="TextBlock.ComboSectionLabel">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.MainHudGold}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="2,0,0,4" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="TextBlock.ComboStatusText">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,2,2,4" />
        </Style>

        <Style Selector="Border.ComboSuggestionFrame">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.Border}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Border.ComboSuggestionFrame.primary">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="58" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.MainHudGold}" />
            <Setter Property="BoxShadow" Value="0 0 10 0 #80E6C26E" />
        </Style>

        <Style Selector="TextBlock.ComboSuggestionName">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MaxWidth" Value="76" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style Selector="TextBlock.ComboSuggestionName.primary">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.MainHudGold}" />
        </Style>

        <Style Selector="Border.ComboChip">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.Border}" />
        </Style>

        <Style Selector="Path.ComboArrow">
            <Setter Property="Stroke" Value="{StaticResource OverlayBrush.TextMuted}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.ComboChainRow">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style Selector="TextBlock.ComboChainDps">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.ComboChainCount">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Styles>

    <Border x:Name="MonitorRoot"
            Classes="MonitorWindowRoot"
            Padding="8,6,10,8"
            PointerPressed="DragWindow">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock x:Name="MonitorInteractionTitle"
                       Grid.Row="0"
                       Classes="MonitorInteractionTitle" />

            <StackPanel Grid.Row="1" Spacing="0" Margin="0,0,0,6">
                <TextBlock Classes="ComboSectionLabel"
                           Text="{Binding SuggestionsTitle}" />
                <TextBlock Classes="ComboStatusText"
                           Text="{Binding StatusText}"
                           IsVisible="{Binding HasStatus}" />
                <ItemsControl ItemsSource="{Binding Suggestions}"
                              IsVisible="{Binding HasSuggestions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComboSuggestionItem">
                            <StackPanel Orientation="Vertical"
                                        VerticalAlignment="Bottom"
                                        ToolTip.Tip="{Binding Reason}">
                                <Border Classes="ComboSuggestionFrame"
                                        Classes.primary="{Binding IsPrimary}"
                                        HorizontalAlignment="Center">
                                    <controls:SkillIcon Classes="MonitorSkillIcon"
                                                        AssetName="{Binding IconAssetName}" />
                                </Border>
                                <TextBlock Classes="ComboSuggestionName"
                                           Classes.primary="{Binding IsPrimary}"
                                           Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="0,0,0,6"
                        IsVisible="{Binding HasRecentCasts}">
                <TextBlock Classes="ComboSectionLabel"
                           Text="{Binding RecentTitle}" />
                <ItemsControl ItemsSource="{Binding RecentCasts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComboSkillChip">
                            <StackPanel Orientation="Horizontal" ToolTip.Tip="{Binding Name}">
                                <Path Classes="ComboArrow" Data="{StaticResource chevron-right}" />
                                <Border Classes="ComboChip">
                                    <controls:SkillIcon Classes="MonitorSkillIcon"
                                                        AssetName="{Binding IconAssetName}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="3"
                        IsVisible="{Binding HasBestChains}">
                <TextBlock Classes="ComboSectionLabel"
                           Text="{Binding BestChainsTitle}" />
                <ItemsControl ItemsSource="{Binding BestChains}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComboChainItem">
                            <Border Classes="ComboChainRow"
                                    ToolTip.Tip="{Binding ToolTipText}">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <ItemsControl Grid.Column="0"
                                                  ItemsSource="{Binding Skills}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ComboSkillChip">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Classes="ComboArrow" Data="{StaticResource chevron-right}" />
                                                    <Border Classes="ComboChip">
                                                        <controls:SkillIcon Classes="MonitorSkillIcon"
                                                                            AssetName="{Binding IconAssetName}" />
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Column="1"
                                               Classes="ComboChainDps"
                                               Text="{Binding DamagePerSecondText}" />
                                    <TextBlock Grid.Column="2"
                                               Classes="ComboChainCount"
                                               Text="{Binding CountText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Classes="MonitorWidthResizeGrip"
                    Grid.RowSpan="5"
                    PointerPressed="ResizeWindow"
                    IsHitTestVisible="True" />
        </Grid>
    </Border>
</Window>
